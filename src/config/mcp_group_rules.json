{
  "servers": [
    "@modelcontextprotocol/server-filesystem",
    "@modelcontextprotocol/server-github"
  ],
  "groups": [
    {
      "name": "file_ops",
      "description": "文件操作工具组",
      "match": [
        "read_file",
        "write_file",
        "edit_file",
        "list_directory",
        "search_files",
        "create_directory",
        "move_file",
        "delete_file"
      ]
    },
    {
      "name": "git_ops",
      "description": "Git 与代码仓库工具组",
      "match": [
        "git_*",
        "create_issue",
        "create_pull_request",
        "get_issue",
        "search_repos",
        "search_code",
        "list_issues",
        "merge_pull_request"
      ]
    },
    {
      "name": "github_ops",
      "description": "GitHub 平台工具组",
      "match": [
        "github_*",
        "gh_*",
        "get_*",
        "list_*"
      ]
    },
    {
      "name": "default",
      "description": "未分组工具默认归属",
      "match": []
    }
  ],
  "default_group": "default"
}
